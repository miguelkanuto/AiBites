OPENROUTER_API_KEY=
# Faixas de modelo (todas gratuitas no OpenRouter; o custo é simulado)
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_MODEL_LIGHT=liquid/lfm-3-1.7b:free
OPENROUTER_MODEL_STRONG=nvidia/nemotron-3-ultra-550b-a55b:free
# Embeddings pela API do Gemini (chave gratuita em aistudio.google.com/apikey; sem cartão)
GEMINI_API_KEY=
EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768

# Usuário do app (menor privilégio). Gerado por: uv run python db/setup_roles.py
AIBITES_DATABASE_URL=postgresql://aibites_app:SENHA@HOST/BANCO?sslmode=require
# Dono do banco: só para seed, recriar o índice e criar o usuário do app. Em produção, não defina.
AIBITES_ADMIN_DATABASE_URL=postgresql://DONO:SENHA@HOST/BANCO?sslmode=require

CHAINLIT_AUTH_SECRET=gere-com-uv-run-chainlit-create-secret
# Opcional: chave do contexto assinado das ferramentas (se vazio, deriva de CHAINLIT_AUTH_SECRET)
MCP_CONTEXT_SECRET=
# Opcional: pasta dos bancos fictícios de RH, TI e Slack (padrão: storage/mock)
AIBITES_MOCK_DIR=
LOG_LEVEL=INFO
# Site: 1 liga o login de demonstração (escolher persona, sem senha); 0 desliga
AIBITES_SITE_DEMO=1
# Opcional: segredo do cookie do site (se vazio, deriva de CHAINLIT_AUTH_SECRET)
SITE_SESSION_SECRET=
# Defina 1 quando o site estiver atrás de HTTPS
AIBITES_SITE_SECURE_COOKIE=0
